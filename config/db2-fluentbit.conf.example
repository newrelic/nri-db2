# External Fluent Bit config for the NR infra agent. The agent adds its own output;
# do not define one here.
[INPUT]
    Name              tail
    Tag               db2diag
    # The usual location is <instance home>/sqllib/db2dump/db2diag.log; use your DIAGPATH.
    Path              /home/db2inst1/sqllib/db2dump/DIAG0000/db2diag.log
    multiline.parser  db2diag_strict
    Read_from_Head    Off
    DB                /var/db/newrelic-infra/db2diag.fb.db

[FILTER]
    Name    record_modifier
    Match   db2diag
    Record  logtype db2diag
