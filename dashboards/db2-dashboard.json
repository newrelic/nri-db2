      "widgets": [
        {
          "id": "575466919",
          "title": "Transaction log utilized (%)",
          "description": "Percentage of the transaction log in use, calculated as `used / (used + available) x 100`",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "gaugeSettings": {
              "display": "auto",
              "displayMode": "arc",
              "max": 100,
              "min": 0,
              "showThresholdLabels": false,
              "showThresholdMarkers": true,
              "thresholdsColorMode": "solid"
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  123
                ],
                "query": "SELECT latest(logUtilized) FROM Db2DatabaseSample where database = {{db_instance}} or db2Hostname = {{db_host}} FACET database "
