    {
      "guid": "Nzg3MTYxNHxWSVp8REFTSEJPQVJEfDUxNDA0MTIy",
      "name": "Extras",
      "description": "Top SQL, long-running statements and lock waits. Requires the optional collectors.",
      "widgets": [
        {
          "id": "575466934",
          "title": "What must be enabled",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 2,
            "height": 2
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "These widgets are empty unless the matching optional collector is on: `COLLECT_TOP_QUERIES=true` (top SQL), `COLLECT_LONG_RUNNING_QUERIES=true` (long-running SQL) and `COLLECT_LOCK_WAITS=true` (lock waits). Each also needs its optional `GRANT EXECUTE` for the monitoring user. Note that these pages show raw SQL statement text, which can contain sensitive literals."
          }
        },
        {
          "id": "575466935",
          "title": "Top SQL by total activity time",
          "layout": {
            "column": 3,
            "row": 1,
            "width": 10,
            "height": 4
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "hiddenColumns": [
              {
                "columnName": "executableId"
              }
            ],
            "initialSorting": {
              "direction": "desc",
              "name": "Total Act Time"
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  123
                ],
                "query": "SELECT latest(statementText), latest(numExecutions) as '# Executions', latest(totalActTime)/1000 as 'Total execution time (sec)', latest(avgActTime)/1000 as 'Avg execution time (sec)', latest(totalCpuTime)/1000 as 'Total CPU time (sec)', latest(totalActWaitTime)/1000 as 'Total wait time (sec)', latest(rowsRead) as 'Total rows read', latest(rowsReturned) as 'Total rows returned' FROM Db2TopQuerySample where database = {{db_instance}} or db2Hostname = {{db_host}} FACET executableId ORDER BY max(totalActTime) LIMIT 25"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
