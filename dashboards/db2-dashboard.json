{
  "name": "IBM DB2",
  "description": "Observability for IBM DB2, collected by the nri-db2 OHI",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Overview",
      "description": "Connectivity, database status, connections, applications and row activity.",
      "widgets": [
        {
          "id": "575466911",
          "title": "Database status",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 6,
            "height": 2
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "dataFormatters": [],
            "facet": {
              "showOtherSeries": false
            },
            "linkedEntityGuids": [
              "{{selfEntity}}"
            ],
            "nrqlQueries": [
              {
                "accountIds": [
                  123
                ],
                "query": "SELECT latest(databaseStatus), latest(databaseStatusCode), latest(canConnect), latest(if(backupLatest < 0, -1, (backupLatest / 86400))) as 'Days since last backup' FROM Db2DatabaseSample FACET db2Hostname, database "
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": [
              {
                "columnName": "Database Status Code",
                "from": 1,
                "severity": "warning",
                "to": 1
              },
              {
                "columnName": "Can Connect",
                "from": 0,
                "severity": "critical",
                "to": 0
              },
              {
                "columnName": "Database Status Code",
                "from": 2,
                "severity": "critical",
                "to": 2
              },
              {
                "columnName": "Database Status Code",
                "from": 3,
                "severity": "unavailable",
                "to": 3
              }
            ]
          }
        },
        {
          "id": "575466915",
          "title": "New connections per interval",
          "description": "New connections made to the database",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 6,
            "height": 2
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "chartStyles": {
