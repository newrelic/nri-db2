{
  "name": "IBM DB2",
  "description": "Monitoring for IBM DB2 collected by the nri-db2 integration.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Overview",
      "description": "Connectivity, database status, connections, applications and row activity.",
      "widgets": [
        {
          "title": "Can connect (1 = yes, 0 = no)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(canConnect) FROM Db2DatabaseSample FACET database"
              }
            ]
          }
        },
        {
          "title": "Database status code (0 OK, 1 warning, 2 critical, 3 unknown)",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(databaseStatusCode) FROM Db2DatabaseSample FACET database"
              }
            ]
          }
        },
        {
          "title": "Database status",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(databaseStatus), latest(databaseStatusCode), latest(canConnect) FROM Db2DatabaseSample FACET database"
              }
            ]
          }
        },
        {
          "title": "Applications active and executing",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(applicationActive), average(applicationExecuting) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Connections active and maximum",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(connectionActive), average(connectionMax) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Row activity per interval (reads, modifications, returned)",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT sum(rowReadsTotal), sum(rowModifiedTotal), sum(rowReturnedTotal) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "New connections per interval",
          "layout": {
            "column": 7,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT sum(connectionTotal) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Locks and log",
      "description": "Lock contention, deadlocks and transaction log usage.",
      "widgets": [
        {
          "title": "Lock waiters and active locks",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(lockWaiting), average(lockActive) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Deadlocks and lock timeouts per interval",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT sum(lockDead), sum(lockTimeouts) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Average lock wait time (ms)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(lockWait) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Transaction log utilized (%)",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(logUtilized) FROM Db2DatabaseSample FACET database"
              }
            ]
          }
        },
        {
          "title": "Transaction log utilized (%) over time",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(logUtilized) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Transaction log used and available",
          "layout": {
            "column": 7,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(logUsed), average(logAvailable) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Log writes and reads per interval",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT sum(logWrites), sum(logReads) FROM Db2DatabaseSample TIMESERIES"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Bufferpools and tablespaces",
      "description": "Bufferpool hit ratios, tablespace utilization and state changes.",
      "widgets": [
        {
          "title": "Bufferpool hit percent",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(bufferpoolHitPercent) FROM Db2BufferpoolSample FACET bufferpoolName TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Bufferpool data page hit percent",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(bufferpoolDataHitPercent) FROM Db2BufferpoolSample FACET bufferpoolName TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Bufferpool index page hit percent",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT average(bufferpoolIndexHitPercent) FROM Db2BufferpoolSample FACET bufferpoolName TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Note on TEMPSPACE1",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 1
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "TEMPSPACE1 always reports 100% utilized, so it is excluded from the tablespace utilization chart below."
          }
        },
        {
          "title": "Tablespace utilized (%), excluding TEMPSPACE1",
          "layout": {
            "column": 1,
            "row": 5,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(tablespaceUtilized) FROM Db2TablespaceSample WHERE tablespaceName != 'TEMPSPACE1' FACET tablespaceName"
              }
            ]
          }
        },
        {
          "title": "Tablespace state",
          "layout": {
            "column": 7,
            "row": 5,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(tablespaceState) FROM Db2TablespaceSample FACET tablespaceName"
              }
            ]
          }
        },
        {
          "title": "Recent tablespace state changes",
          "layout": {
            "column": 1,
            "row": 8,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT summary, tablespaceName, previousTablespaceState, tablespaceState FROM InfrastructureEvent WHERE category = 'Db2TablespaceStateChange'"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Diagnostic logs",
      "description": "Db2 diagnostic log (db2diag) records by level, component and severity. Mode 1 (JSONL) only.",
      "widgets": [
        {
          "title": "What must be enabled",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 2
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "These widgets show Mode 1 (JSONL) records only. Enable `COLLECT_DIAG_LOGS=true` on the integration (records are read remotely through `PD_GET_DIAG_HIST` and tailed from a local JSONL file by the agent) and activate the Mode 1 log config. Records from the on-host `db2diag.log` tail (Mode 2) do not carry the `level`, `component` and `diagMessage` attributes these widgets use, so they do not appear here. The widgets are empty until Mode 1 is on."
          }
        },
        {
          "title": "Diagnostic records by level (Mode 1 only)",
          "layout": {
            "column": 1,
            "row": 3,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT count(*) FROM Log WHERE logtype = 'db2diag' FACET level TIMESERIES"
              }
            ]
          }
        },
        {
          "title": "Recent Error and Severe records (Mode 1 only)",
          "layout": {
            "column": 1,
            "row": 6,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT recordId, level, function, diagMessage FROM Log WHERE logtype = 'db2diag' AND level IN ('Error','Severe') LIMIT 50"
              }
            ]
          }
        },
        {
          "title": "Diagnostic records by component (Mode 1 only)",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT count(*) FROM Log WHERE logtype = 'db2diag' FACET component"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Extras",
      "description": "Top SQL, long-running statements and lock waits. Requires the optional collectors.",
      "widgets": [
        {
          "title": "What must be enabled",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 12,
            "height": 2
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "These widgets are empty unless the matching optional collector is on: `COLLECT_TOP_QUERIES=true` (top SQL), `COLLECT_LONG_RUNNING_QUERIES=true` (long-running SQL) and `COLLECT_LOCK_WAITS=true` (lock waits). Each also needs its optional `GRANT EXECUTE` for the monitoring user. Note that these pages show raw SQL statement text, which can contain sensitive literals."
          }
        },
        {
          "title": "Top SQL by total activity time",
          "layout": {
            "column": 1,
            "row": 3,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(statementText), latest(numExecutions), latest(totalActTime), latest(avgActTime), latest(totalCpuTime), latest(rowsRead) FROM Db2TopQuerySample FACET executableId ORDER BY max(totalActTime) LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Long-running SQL",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(elapsedSeconds), latest(applicationName), latest(activityState), latest(statementText) FROM Db2LongRunningQuerySample FACET applicationHandle"
              }
            ]
          }
        },
        {
          "title": "Current lock waits",
          "layout": {
            "column": 1,
            "row": 11,
            "width": 6,
            "height": 4
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT latest(waitSeconds), latest(holderApplicationHandle), latest(lockMode), latest(lockModeRequested), latest(lockObjectType) FROM Db2LockWaitSample FACET applicationHandle"
              }
            ]
          }
        },
        {
          "title": "Lock wait seconds over time",
          "layout": {
            "column": 7,
            "row": 11,
            "width": 6,
            "height": 4
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "SELECT max(waitSeconds) FROM Db2LockWaitSample FACET applicationHandle TIMESERIES"
              }
            ]
          }
        }
      ]
    }
  ]
}
